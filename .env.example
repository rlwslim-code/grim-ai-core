# Copy to .env. Never commit your .env or runtime data.
GRIM_DATA_DIR=./data
GRIM_MODEL_BASE_URL=http://127.0.0.1:11434/v1
GRIM_MODEL=qwen2.5:3b
GRIM_MODEL_API_KEY=
GRIM_ALLOWED_ORIGINS=http://localhost:5173

# Bootstrap first owner while bound to localhost; subsequent registrations are disabled.
GRIM_ALLOW_REGISTRATION=0

# Optional real embedding retrieval; pull this model in Ollama separately.
# GRIM_EMBEDDING_MODEL=nomic-embed-text

# Opt in only if this inference endpoint needs your configured environment proxy.
GRIM_MODEL_TRUST_ENV=0
